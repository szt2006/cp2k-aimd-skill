@SET DATAPATH /opt/cp2k/cp2k-6.1/data

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME ${DATAPATH}/BASIS_MOLOPT
#    POTENTIAL_FILE_NAME ./rr_pot
    POTENTIAL_FILE_NAME ${DATAPATH}/GTH_POTENTIALS
    WFN_RESTART_FILE_NAME ./cp2k-RESTART.wfn
    PLUS_U_METHOD MULLIKEN 
 #  CHARGE +2
    UKS  T
    &MGRID
      CUTOFF 350
    &END MGRID
    &QS
      WF_INTERPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
#    &POISSON
#      PERIODIC NONE
#      POISSON_SOLVER MT
#      &MT
#        ALPHA 7.0
#        REL_CUTOFF 1.2
#      &END MT
#    &END POISSON
    &SCF
     EPS_SCF  3.0E-6
     SCF_GUESS RESTART
     MAX_SCF 150
     &OT T
    #  ENERGY_GAP 0.002
       PRECONDITIONER FULL_SINGLE_INVERSE
    #   MINIMIZER CG
       MINIMIZER DIIS      
    #   LINESEARCH 3PNT
     &END OT

     &OUTER_SCF ON
       MAX_SCF 4
       EPS_SCF 1.0E-5
     &END OUTER_SCF 

     &PRINT
       &RESTART
         &EACH
           QS_SCF 100
         &END EACH
         ADD_LAST NUMERIC
       &END RESTART
      &END PRINT 
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &vdW_POTENTIAL
         DISPERSION_FUNCTIONAL PAIR_POTENTIAL
         &PAIR_POTENTIAL
            TYPE DFTD3
            CALCULATE_C9_TERM .TRUE.
            PARAMETER_FILE_NAME ${DATAPATH}/dftd3.dat
            REFERENCE_FUNCTIONAL PBE
            R_CUTOFF 15.
         &END PAIR_POTENTIAL
      &END vdW_POTENTIAL
    &END XC

    &PRINT
       &MULLIKEN  SILENT
         FILENAME =Mull.mulliken
         &EACH
           MD            5 
         &END EACH
       &END MULLIKEN
#       &E_DENSITY_CUBE
#         FILENAME Dentity_maybeSpin.cube
#       &END E_DENSITY_CUBE
#       &MO_CUBES
#         NLUMO 1
#         FILENAME MO.cube 
#       &END MO_CUBES
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
     ABC 17.7540   19.4907   27.2817 
     ALPHA_BETA_GAMMA  90 90 90
    &END CELL
    &COORD
	  @INCLUDE 'coord.inc'
	&END COORD
#    &TOPOLOGY
#      &CENTER_COORDINATES
#      &END CENTER_COORDINATES
#   &END TOPOLOGY
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH 
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND In
      BaSIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q13
    &END KIND
    &KIND Al
      BaSIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3 
    &END KIND
    &KIND Ni
      BaSIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q18
    &END KIND
    &KIND Ti
      BaSIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
         &DFT_PLUS_U
             EPS_U_RAMPING 1.0E-3
             L 2
             U_MINUS_J [eV] 13.6
         &END
    &END KIND
    &KIND Au
      MASS 19.7
      BaSIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q11
    &END KIND
   &END SUBSYS
&END FORCE_EVAL
&GLOBAL
#  FFTLIB FFTSG
  PROJECT cp2k
#  RUN_TYPE GEO_OPT
#  RUN_TYPE ENERGY
  RUN_TYPE MD
  PRINT_LEVEL LOW   
&END GLOBAL
 &MOTION
    &MD
    ENSEMBLE NVT
    STEPS 100000
    TIMESTEP 2 
    TEMPERATURE 600.0
#   ANNEALING 0.98
# use in NVT ensemble
    &THERMOSTAT
      TYPE NOSE
#     REGION MASSIVE
      &NOSE
        LENGTH 3
        YOSHIDA 3
        MTS 2
        TIMECON [wavenumber_t] 1000
      &END NOSE
    &END THERMOSTAT
  &END MD
  &GEO_OPT
    MAX_ITER 400
   OPTIMIZER LBFGS
#   OPTIMIZER BFGS
#    OPTIMIZER CG
    MAX_FORCE 6.0E-4
    &LBFGS
      MAX_H_RANK 30
    &END LBFGS
#    &CG
#      &LINE_SEARCH
#        TYPE 2PNT
#      &END LINE_SEARCH
#    &END CG
  &END GEO_OPT
  &CONSTRAINT
     &FIXED_ATOMS
        LIST  1..54
	LIST  289..324
     &END FIXED_ATOMS
  &END CONSTRAINT
&END MOTION
