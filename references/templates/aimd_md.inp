&GLOBAL
  PROJECT __PROJECT__
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
__GLOBAL_PRINT__
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    __BASIS_ADMM_FILE__
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE __CHARGE__
__SPIN__
__SURFACE_DIPOLE_BLOCK__
    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &XC
__XC_BLOCK__
__VDW_BLOCK__
    &END XC
__ADMM_BLOCK__
__POISSON_BLOCK__
    __QS_BLOCK__
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
__MIXING_BLOCK__
__OT_BLOCK__
__SMEAR_BLOCK__
__OUTER_SCF_BLOCK__
    &END SCF
__DFT_PRINT_BLOCK__
__LOCALIZE_BLOCK__
  &END DFT
  &SUBSYS
    &KIND __ELEM__
      ELEMENT __ELEM__
      BASIS_SET __BASIS__
      POTENTIAL __POTENTIAL__
    &END KIND
    &CELL
      A __A1__ __A2__ __A3__
      B __B1__ __B2__ __B3__
      C __C1__ __C2__ __C3__
    &END CELL
    __STRUCTURE_BLOCK__
  &END SUBSYS
__FE_PRINT_BLOCK__
&END FORCE_EVAL
&MOTION
  &MD
    ENSEMBLE __ENSEMBLE__
    STEPS 500000
    TIMESTEP 0.5
    TEMPERATURE 600.0
__THERMOSTAT_BLOCK__
__BAROSTAT_BLOCK__
    # ANNEALING 0.98   # 退火时取消注释（每步温度乘 0.98）
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
__VELOCITIES_BLOCK__
__RESTART_BLOCK__
  &END PRINT
__CONSTRAINT_BLOCK__
&END MOTION
