&GLOBAL
  PROJECT __PROJECT__
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
__GLOBAL_PRINT__
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    __BASIS_ADMM_FILE__
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE __CHARGE__
__SPIN__
__SURFACE_DIPOLE_BLOCK__
    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &XC
__XC_BLOCK__
__VDW_BLOCK__
    &END XC
__ADMM_BLOCK__
__POISSON_BLOCK__
    __QS_BLOCK__
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
__MIXING_BLOCK__
__OT_BLOCK__
__SMEAR_BLOCK__
__OUTER_SCF_BLOCK__
    &END SCF
__DFT_PRINT_BLOCK__
__LOCALIZE_BLOCK__
  &END DFT
  &SUBSYS
    &KIND __ELEM__
      ELEMENT __ELEM__
      BASIS_SET __BASIS__
      POTENTIAL __POTENTIAL__
    &END KIND
    &CELL
      A __A1__ __A2__ __A3__
      B __B1__ __B2__ __B3__
      C __C1__ __C2__ __C3__
    &END CELL
    __STRUCTURE_BLOCK__
  &END SUBSYS
__FE_PRINT_BLOCK__
&END FORCE_EVAL
&MOTION
  &GEO_OPT
__OPTIMIZER_BLOCK__
    MAX_ITER 400
    MAX_FORCE 6.0E-4
    MAX_DR 0.003
    RMS_FORCE 0.0003
    RMS_DR 0.0015
  &END GEO_OPT
__CONSTRAINT_BLOCK__
&END MOTION
