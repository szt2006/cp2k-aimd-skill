&GLOBAL
  PROJECT t6
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW

&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS
    MULTIPLICITY 3
    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL

    &END XC


        &QS
      WF_INTERPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
        &MIXING
          METHOD MULTISECANT_MIXING
          NBUFFER 5
        &END MIXING
        &OT
          MINIMIZER CG
          PRECONDITIONER FULL_SINGLE_INVERSE
        &END OT
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR

    &END SCF


  &END DFT
  &SUBSYS
    &KIND Ni
      ELEMENT Ni
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q18
    &END KIND
    &CELL
      A 5.43 0 0
      B 0 5.43 0
      C 0 0 5.43
    &END CELL
    &COORD
# TODO: fill &COORD with 'Element x y z' per line
    &END COORD
  &END SUBSYS

&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 400
    MAX_FORCE 6.0E-4
    MAX_DR 0.003
    RMS_FORCE 0.0003
    RMS_DR 0.0015
  &END GEO_OPT

&END MOTION
