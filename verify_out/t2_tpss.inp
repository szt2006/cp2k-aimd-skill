&GLOBAL
  PROJECT t2
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW

&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0

    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &XC
      &XC_FUNCTIONAL
        &TPSS
          SCALE_X 1.0
          SCALE_C 1.0
        &END TPSS
      &END XC_FUNCTIONAL

    &END XC


    
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
        &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.4
          NBROYDEN 8
        &END MIXING



    &END SCF


  &END DFT
  &SUBSYS
    &KIND Si
      ELEMENT Si
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q4
    &END KIND
    &CELL
      A 5.43 0 0
      B 0 5.43 0
      C 0 0 5.43
    &END CELL
    &COORD
# TODO: fill &COORD with 'Element x y z' per line
    &END COORD
  &END SUBSYS

&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 400
    MAX_FORCE 6.0E-4
    MAX_DR 0.003
    RMS_FORCE 0.0003
    RMS_DR 0.0015
  &END GEO_OPT

&END MOTION
