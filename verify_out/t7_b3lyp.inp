&GLOBAL
  PROJECT t7
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW

&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
        BASIS_SET_FILE_NAME BASIS_ADMM_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS
    MULTIPLICITY 5
    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &XC
      &XC_FUNCTIONAL
        &LYP
          SCALE_C 0.81
        &END LYP
        &BECKE88
          SCALE_X 0.72
        &END BECKE88
        &VWN
          FUNCTIONAL_TYPE VWN3
          SCALE_C 0.19
        &END VWN
        &XALPHA
          SCALE_X 0.08
        &END XALPHA
      &END XC_FUNCTIONAL
      &HF
        &SCREENING
          EPS_SCHWARZ 1.0E-10
        &END SCREENING
        &MEMORY
          MAX_MEMORY 512
          EPS_STORAGE_SCALING 1.0E-1
        &END MEMORY
        FRACTION 0.20
      &END HF
    &VDW_POTENTIAL
      POTENTIAL_TYPE PAIR_POTENTIAL
      &PAIR_POTENTIAL
        TYPE DFTD3
        PARAMETER_FILE_NAME dftd3.dat
        REFERENCE_FUNCTIONAL PBE
        R_CUTOFF [angstrom] 12
      &END PAIR_POTENTIAL
    &END VDW_POTENTIAL
    &END XC
    &AUXILIARY_DENSITY_MATRIX_METHOD
      METHOD BASIS_PROJECTION
      ADMM_PURIFICATION_METHOD MO_DIAG
      EXCH_CORRECTION_FUNC PBEX
    &END AUXILIARY_DENSITY_MATRIX_METHOD

        &QS
      WF_INTERPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
        &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.4
          NBROYDEN 8
        &END MIXING



    &END SCF


  &END DFT
  &SUBSYS
    &KIND Ti
      ELEMENT Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q12
      BASIS_SET AUX_FIT cFIT3
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q6
      BASIS_SET AUX_FIT cFIT3
    &END KIND
    &CELL
      A 5.43 0 0
      B 0 5.43 0
      C 0 0 5.43
    &END CELL
    &COORD
# TODO: fill &COORD with 'Element x y z' per line
    &END COORD
  &END SUBSYS

&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 400
    MAX_FORCE 6.0E-4
    MAX_DR 0.003
    RMS_FORCE 0.0003
    RMS_DR 0.0015
  &END GEO_OPT

&END MOTION
