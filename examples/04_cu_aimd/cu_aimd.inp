&GLOBAL
  PROJECT cu_aimd
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM

&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0


    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL

    &END XC


    
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
        &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.4
          NBROYDEN 8
        &END MIXING

      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR

    &END SCF


  &END DFT
  &SUBSYS
    &KIND Cu
      ELEMENT Cu
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q11
    &END KIND
    &CELL
      A 3.615 0.0 0.0
      B 0.0 3.615 0.0
      C 0.0 0.0 3.615
    &END CELL
      &COORD
Cu 0.000000 0.000000 0.000000
Cu 1.807500 1.807500 0.000000
Cu 1.807500 0.000000 1.807500
Cu 0.000000 1.807500 1.807500
  &END COORD
  &END SUBSYS

&END FORCE_EVAL
&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 500
    TIMESTEP 0.5
    TEMPERATURE 600.0
      &THERMOSTAT
        TYPE AD_LANGEVIN
        &AD_LANGEVIN
          TIMECON_LANGEVIN [fs] 100
          TIMECON_NH [fs] 100
        &END AD_LANGEVIN
      &END THERMOSTAT

    # ANNEALING 0.98   # 退火时取消注释（每步温度乘 0.98）
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 1
      &END EACH
    &END VELOCITIES
    &RESTART
      BACKUP_COPIES 3
      &EACH
        MD 1
      &END EACH
    &END RESTART
    &RESTART_HISTORY
      &EACH
        MD 100
      &END EACH
    &END RESTART_HISTORY
  &END PRINT

&END MOTION
