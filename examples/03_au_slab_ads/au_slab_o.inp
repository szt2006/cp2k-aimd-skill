&GLOBAL
  PROJECT au_slab_o
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW

&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS
    MULTIPLICITY 3

    &MGRID
      NGRIDS 4
      CUTOFF 400.0
      REL_CUTOFF 60
    &END MGRID
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 1
      SYMMETRY OFF
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &VDW_POTENTIAL
      POTENTIAL_TYPE PAIR_POTENTIAL
      &PAIR_POTENTIAL
        TYPE DFTD3
        PARAMETER_FILE_NAME dftd3.dat
        REFERENCE_FUNCTIONAL PBE
        R_CUTOFF [angstrom] 12
      &END PAIR_POTENTIAL
    &END VDW_POTENTIAL
    &END XC

    &POISSON
      PERIODIC XY
    &END POISSON
        &QS
      WF_INTERPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      EPS_DIIS 0.05
      ADDED_MOS 500
      CHOLESKY INVERSE
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
        &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
        &END MIXING

      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR

    &END SCF


  &END DFT
  &SUBSYS
    &KIND Au
      ELEMENT Au
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q11
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q6
    &END KIND
    &CELL
      A 8.156 0.0 0.0
      B 0.0 8.156 0.0
      C 0.0 0.0 25.0
    
PERIODIC XY
&END CELL
      &COORD
Au 0.000000 0.000000 0.000000
Au 4.078000 0.000000 0.000000
Au 0.000000 4.078000 0.000000
Au 4.078000 4.078000 0.000000
Au 2.039000 2.039000 2.039000
Au 6.117000 2.039000 2.039000
Au 2.039000 6.117000 2.039000
Au 6.117000 6.117000 2.039000
Au 0.000000 0.000000 4.078000
Au 4.078000 0.000000 4.078000
Au 0.000000 4.078000 4.078000
Au 4.078000 4.078000 4.078000
O 0.000000 0.000000 6.078000
  &END COORD
  &END SUBSYS

&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 400
    MAX_FORCE 6.0E-4
    MAX_DR 0.003
    RMS_FORCE 0.0003
    RMS_DR 0.0015
  &END GEO_OPT

&END MOTION
