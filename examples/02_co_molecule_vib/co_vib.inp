&GLOBAL
  PROJECT co_vib
  RUN_TYPE VIBRATIONAL_ANALYSIS
  PRINT_LEVEL MEDIUM

&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS
    MULTIPLICITY 1
    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL

    &END XC

    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
        &QS
      WF_INTERPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 300
        &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.4
          NBROYDEN 8
        &END MIXING



    &END SCF


  &END DFT
  &SUBSYS
    &KIND C
      ELEMENT C
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q4
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q6
    &END KIND
    &CELL
      A 12.0 0.0 0.0
      B 0.0 12.0 0.0
      C 0.0 0.0 12.0
    
PERIODIC NONE
&END CELL
      &COORD
C 5.436000 6.000000 6.000000
O 6.564000 6.000000 6.000000
  &END COORD
  &END SUBSYS

&END FORCE_EVAL
&VIBRATIONAL_ANALYSIS
  DX 0.01
  INTENSITIES T
  NPROC_REP 8
  FULLY_PERIODIC T
&END VIBRATIONAL_ANALYSIS
&MOTION

&END MOTION
